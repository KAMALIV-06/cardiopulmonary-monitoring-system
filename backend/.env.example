# Cardiopulmonary Backend Environment Configuration
PROJECT_NAME="Cardiopulmonary Monitoring and Early Risk Detection System"
API_V1_STR="/api/v1"
APP_ENV=development
AUTO_START_SIMULATOR=true

# PostgreSQL is the intended database. Configure local credentials; do not commit secrets.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DEFAULT_PATIENT_ID=PATIENT-001
DEFAULT_DEVICE_ID=SIM-DEV-01
